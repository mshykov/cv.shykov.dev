{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cv-shykov-dev",
  "compatibility_date": "2026-06-22",
  "observability": {
    "enabled": true
  },
  "assets": {
    // NOT "single-page-application": this app has no client-side router, so the
    // SPA fallback only meant every mistyped URL answered 200 with the
    // homepage. Search engines read that as a soft 404. dist/404.html is
    // generated by scripts/prerender.mjs so it can reference the hashed CSS.
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Attaches cv.shykov.dev to this Worker. On deploy, Cloudflare provisions
  // the DNS record + TLS cert automatically (shykov.dev is on this account).
  "routes": [
    { "pattern": "cv.shykov.dev", "custom_domain": true }
  ]
}
