  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Privacy-first CV toolkit — parse, analyze, JD-match, and build ATS-clean resumes entirely in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:debug": "tsc -b && VITE_SOURCEMAPS=true vite build",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "smoke:build": "node scripts/smoke-built.mjs",
    "preview": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.8.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "wrangler": "^4.103.0"
  }
